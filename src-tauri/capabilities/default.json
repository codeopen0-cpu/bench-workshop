{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Bench Workshop window may do: open/save dialogs, read/write the project files picked in them, keep libraries in Documents/Bench Workshop/libraries, open that folder, restart itself. Sign in to GitHub (device sign-in) and publish libraries as pull requests. Check for, download and install updates (signed). Open a board's web page (this PC only) in the user's browser. Set its own zoom (the UI size setting).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "process:allow-restart",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOCUMENT/Bench Workshop"
        },
        {
          "path": "$DOCUMENT/Bench Workshop/**"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DOCUMENT/Bench Workshop"
        },
        {
          "path": "$DOCUMENT/Bench Workshop/**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://github.com/login/device/code"
        },
        {
          "url": "https://github.com/login/oauth/access_token"
        },
        {
          "url": "https://api.github.com/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/*"
        },
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    },
    "updater:default"
  ]
}